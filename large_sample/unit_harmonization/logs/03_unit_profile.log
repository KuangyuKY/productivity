. *########################### 3  每产品单位集中度 ###########################
. * ★ 这一节直接决定策略选 A（只留主导单位）还是 C（把 (产品,单位) 当分析单元）
. capture program drop _produnit

. program define _produnit
  1.     args side
  2. 
.     di _n(2) as text "================================================================"
  3.     di as result "  3  每产品单位集中度 —— `side' 侧"
  4.     di as text "================================================================"
  5. 
.     use "$dta/firm_`side'_clean.dta", clear
  6.     qui collapse (sum) value qty (count) nrec = p, by(product_id unit)
  7. 
.     * 每个产品：有几个不同单位、总金额
.     bysort product_id: egen double v_prod = total(value)
  8.     bysort product_id: gen long  n_units  = _N
  9. 
.     * 主导单位 = 该产品内金额最大的单位
.     * （按 value 升序排，组内最后一行即最大；不用 gsort，避免 by 前缀的排序坑）
.     bysort product_id (value): gen byte is_dom = (_n == _N)
 10.     qui gen double dom_share = value / v_prod
 11. 
.     * ---- 分布 1：每产品的单位数 ----
.     preserve
 12.         qui keep if is_dom
 13.         qui gen byte ubin = .
 14.         qui replace ubin = 1 if n_units == 1
 15.         qui replace ubin = 2 if n_units == 2
 16.         qui replace ubin = 3 if inrange(n_units, 3, 5)
 17.         qui replace ubin = 4 if inrange(n_units, 6, 10)
 18.         qui replace ubin = 5 if inrange(n_units, 11, 20)
 19.         qui replace ubin = 6 if n_units > 20
 20.         label define UB 1 "1 个单位" 2 "2 个" 3 "3-5 个" 4 "6-10 个" ///
>                         5 "11-20 个" 6 ">20 个", replace
 21.         label values ubin UB
 22. 
.         di _n as text "  每个产品有多少个不同单位（产品数 / 按产品数占比）"
 23.         tabulate ubin
 24. 
.         di _n as text "  同上，但按【金额】加权（这个更重要）"
 25.         qui summ v_prod, meanonly
 26.         local T = r(sum)
 27.         forvalues b = 1/6 {
 28.             qui summ v_prod if ubin == `b', meanonly
 29.             local s = cond(r(N) == 0, 0, r(sum) / `T')
 30.             di as text "    " %-12s "`: label UB `b''" _col(20) as result %7.4f `s'
 31.         }
 32. 
.         * ---- 分布 2：主导单位占该产品金额的比例 ----
.         di _n as text "  主导单位占该产品金额的比例 —— 分布"
 33.         summarize dom_share, detail
 34. 
.         di _n as text "  主导单位占比分档（产品数）"
 35.         qui gen byte dbin = .
 36.         qui replace dbin = 1 if dom_share >= 0.99
 37.         qui replace dbin = 2 if dom_share >= 0.95 & dom_share < 0.99
 38.         qui replace dbin = 3 if dom_share >= 0.90 & dom_share < 0.95
 39.         qui replace dbin = 4 if dom_share >= 0.75 & dom_share < 0.90
 40.         qui replace dbin = 5 if dom_share >= 0.50 & dom_share < 0.75
 41.         qui replace dbin = 6 if dom_share <  0.50
 42.         label define DB 1 ">=99%" 2 "95-99%" 3 "90-95%" 4 "75-90%" ///
>                         5 "50-75%" 6 "<50%", replace
 43.         label values dbin DB
 44.         tabulate dbin
 45. 
.         qui summ value, meanonly
 46.         local kept = r(sum)
 47.         qui summ v_prod, meanonly
 48.         local tot = r(sum)
 49.         di _n as text "  ★ 若选策略 A（只留主导单位），会丢掉的金额占比 = " ///
>             as result %6.4f `=1 - `kept'/`tot''
 50. 
.         keep product_id unit n_units v_prod value dom_share
 51.         rename unit  dom_unit
 52.         rename value dom_value
 53.         order product_id n_units dom_unit dom_share dom_value v_prod
 54.         gsort -v_prod
 55.         export delimited using "$prof/product_unit_`side'.csv", replace
 56.     restore
 57. end

. 
. _produnit buy


