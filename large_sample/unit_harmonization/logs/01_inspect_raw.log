. *########################### 体检程序 ###########################
. * _inspect：对内存中已 import 好的数据做逐列体检
. *   1) 行数 / describe（列名 + 存储类型 + 显示格式）
. *   2) 前 20 行原样打印
. *   3) 逐列：字符串 → 空串数、字面 NULL 数、长度 min/max、去重取值数
. *             数值   → 缺失数、summarize（N/mean/sd/min/max）
. *   4) 项目代码专项：是否被读成数值（19 位码丢精度的红线）
. *   5) 单位专项：去重取值数 + 按频次排序的 Top 40（★ 破坏性，放最后）
. capture program drop _inspect

. program define _inspect
  1.     args tag
  2. 
.     di _n(2) as text "================================================================"
  3.     di as result "  数据集：`tag'"
  4.     di as text "================================================================"
  5. 
.     * ----- 1) 行数 + 结构 -----
.     count
  6.     di _n as text ">>> 行数 = " as result r(N)
  7.     di _n as text ">>> describe（列名 / 存储类型 / 显示格式 / 值标签）"
  8.     describe, fullnames
  9. 
.     * ----- 2) 前 20 行原样 -----
.     qui count
 10.     local n20 = min(20, r(N))
 11.     di _n as text ">>> 前 `n20' 行原样"
 12.     list in 1/`n20', clean noobs
 13. 
.     * ----- 3) 逐列体检 -----
.     di _n as text ">>> 逐列体检"
 14.     foreach v of varlist _all {
 15.         di _n as text "  ----------------------------------------------------------"
 16.         capture confirm string variable `v'
 17.         if _rc == 0 {
 18.             di as result "  [字符串] `v'"
 19. 
.             qui count if trim(`v') == ""
 20.             di as text "    空串/纯空白           : " as result r(N)
 21. 
.             qui count if inlist(upper(trim(`v')), "NULL", "(NULL)", "NA", "N/A", "#N/A", "NAN", ".")
 22.             di as text "    字面 NULL/NA 类       : " as result r(N)
 23. 
.             tempvar L
 24.             qui gen int `L' = length(`v')
 25.             qui summ `L'
 26.             di as text "    字符长度 min/max      : " as result r(min) " / " r(max)
 27.             drop `L'
 28. 
.             tempvar T
 29.             qui egen byte `T' = tag(`v')
 30.             qui count if `T'
 31.             di as text "    去重取值数            : " as result r(N)
 32.             drop `T'
 33.         }
 34.         else {
 35.             di as result "  [数值] `v'"
 36. 
.             qui count if missing(`v')
 37.             di as text "    缺失（.）             : " as result r(N)
 38. 
.             qui count if `v' <= 0 & !missing(`v')
 39.             di as text "    <= 0                  : " as result r(N)
 40. 
.             summ `v', format
 41.         }
 42.     }
 43. 
.     * ----- 4) 项目代码专项 -----
.     di _n as text "  ----------------------------------------------------------"
 44.     capture confirm variable 项目代码
 45.     if _rc != 0 {
 46.         di as error "  ！找不到变量【项目代码】—— 请核对 describe 里的实际列名"
 47.     }
 48.     else {
 49.         capture confirm string variable 项目代码
 50.         if _rc == 0 {
 51.             di as result "  项目代码 = 字符串 ✓（19 位码安全）"
 52.             di as text   "  按长度分布："
 53.             tempvar LP
 54.             qui gen int `LP' = length(trim(项目代码))
 55.             tabulate `LP', missing
 56.             drop `LP'
 57.             di as text "  非纯数字的项目代码行数："
 58.             qui count if !regexm(trim(项目代码), "^[0-9]+$")
 59.             di as result "    " r(N)
 60.         }
 61.         else {
 62.             di as error "  ★★★ 项目代码 被 import delimited 读成了【数值型】"
 63.             di as error "  ★★★ 19 位码超出双精度整数上限(2^53≈16位)，末几位会被抹平"
 64.             di as error "  ★★★ 清洗代码里必须改成 import delimited …, stringcols(…) 或先 tostring"
 65.             summ 项目代码, format
 66.             di as text "  存储类型 / 显示格式："
 67.             describe 项目代码
 68.         }
 69.     }
 70. 
.     * ----- 4b) year 专项 -----
.     di _n as text "  ----------------------------------------------------------"
 71.     capture confirm variable year
 72.     if _rc != 0 {
 73.         di as error "  ！找不到变量【year】—— 请核对 describe 里的实际列名"
 74.     }
 75.     else {
 76.         di as result "  year 分布："
 77.         tabulate year, missing
 78.     }
 79. 
.     * ----- 5) 单位专项（★ contract 会重塑数据，必须放最后）-----
.     di _n as text "  ----------------------------------------------------------"
 80.     capture confirm variable 单位
 81.     if _rc != 0 {
 82.         di as error "  ！找不到变量【单位】—— 请核对 describe 里的实际列名"
 83.     }
 84.     else {
 85.         capture confirm string variable 单位
 86.         if _rc != 0 {
 87.             di as error "  ！【单位】被读成了数值型，很反常，请看上面的 describe"
 88.             tostring 单位, replace force
 89.         }
 90.         di as result "  单位：按频次排序的 Top 50（含空串）"
 91.         contract 单位, freq(_freq)
 92.         gsort -_freq
 93.         qui count
 94.         local nu = r(N)
 95.         local n50 = min(50, `nu')
 96.         di as text "    单位去重取值数（原始，未做任何规整）= " as result `nu'
 97.         list in 1/`n50', clean noobs
 98.         di as text "    —— 上面只列了前 `n50' 个（共 `nu' 个），完整清单进下一步画像"
 99.     }
100. end

. 
. 
