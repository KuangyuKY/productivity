. *########################### 指标程序 ###########################
. * _conc：给定一个"单位变量"，报三个指标
. *   1 每产品的不同单位数（分档，按产品数 + 按金额加权）
. *   2 主导单位占该产品金额的比例（分位数）
. *   3 策略 A（只留主导单位）会丢掉的金额占比
. * args 1 = 单位变量名   2 = 标题
. capture program drop _conc

. program define _conc
  1.     args uvar title
  2. 
.     di _n as text "  ---------------- `title' ----------------"
  3. 
.     preserve
  4.         qui collapse (sum) value, by(product_id `uvar')
  5.         bysort product_id: egen double v_prod = total(value)
  6.         bysort product_id: gen long   n_units = _N
  7.         bysort product_id (value): gen byte is_dom = (_n == _N)
  8.         qui gen double dom_share = value / v_prod
  9. 
.         qui summ value if is_dom, meanonly
 10.         local kept = r(sum)
 11. 
.         qui keep if is_dom
 12.         qui summ v_prod, meanonly
 13.         local tot = r(sum)
 14. 
.         qui summ n_units, detail
 15.         di as text "    每产品单位数    中位数=" as result %6.0f r(p50) ///
>            as text "  均值=" as result %8.2f r(mean) ///
>            as text "  p90=" as result %6.0f r(p90) ///
>            as text "  max=" as result %6.0f r(max)
 16. 
.         qui summ dom_share, detail
 17.         di as text "    主导单位占比    中位数=" as result %6.4f r(p50) ///
>            as text "  均值=" as result %6.4f r(mean) ///
>            as text "  p10=" as result %6.4f r(p10) ///
>            as text "  p25=" as result %6.4f r(p25)
 18. 
.         di as text "    ★ 策略A 丢掉金额  = " as result %6.4f `=1 - `kept'/`tot''
 19. 
.         qui count if n_units == 1
 20.         di as text "    只有 1 个单位的产品数 = " as result r(N) ///
>            as text " / " as result `=_N'
 21. 
.         qui gen byte dbin = .
 22.         qui replace dbin = 1 if dom_share >= 0.99
 23.         qui replace dbin = 2 if dom_share >= 0.95 & dom_share < 0.99
 24.         qui replace dbin = 3 if dom_share >= 0.90 & dom_share < 0.95
 25.         qui replace dbin = 4 if dom_share >= 0.75 & dom_share < 0.90
 26.         qui replace dbin = 5 if dom_share >= 0.50 & dom_share < 0.75
 27.         qui replace dbin = 6 if dom_share <  0.50
 28.         label define DB 1 ">=99%" 2 "95-99%" 3 "90-95%" 4 "75-90%" ///
>                         5 "50-75%" 6 "<50%", replace
 29.         label values dbin DB
 30.         di _n as text "    主导单位占比分档（产品数）"
 31.         tabulate dbin
 32.     restore
 33. end

. 
. 
. *########################### Part B：逐侧施加映射 ###########################
. foreach side in buy sell {
  2. 
.     di _n(2) as text "================================================================"
  3.     di as result "  firm_`side'"
  4.     di as text "================================================================"
  5. 
.     use "$dta/firm_`side'_clean.dta", clear
  6.     qui count
  7.     local n0 = r(N)
  8. 
.     qui merge m:1 unit using "`map'"
  9.     qui drop if _merge == 2
 10. 
.     * 不在 124 里的（_merge==1）→ OTHER，保留不丢
.     qui replace dimension = "OTHER"   if _merge == 1
 11.     qui replace base_unit = "OTHER"   if _merge == 1
 12.     qui replace factor    = 1         if _merge == 1
 13. 
.     qui count if _merge == 1
 14.     local nother = r(N)
 15.     qui summ value if _merge == 1, meanonly
 16.     local vother = r(sum)
 17.     qui summ value, meanonly
 18.     local vtot = r(sum)
 19.     di as text "  落入 OTHER 的行数   = " as result %12.0fc `nother' ///
>        as text "  （占 " as result %5.2f `=100*`nother'/`n0'' as text "%）"
 20.     di as text "  落入 OTHER 的金额占比 = " as result %6.4f `=`vother'/`vtot''
 21.     drop _merge
 22. 
.     * ---- 折算 ----
.     * qty_std：可换算量纲乘系数；不可换算量纲 factor=1，数量原样
.     qui gen double qty_std  = qty * factor
 23.     qui gen str24  unit_std = base_unit
 24.     qui gen double p_std    = value / qty_std
 25.     label var qty_std  "折算到基准单位后的数量"
 26.     label var unit_std "规范单位（同量纲已折算到基准）"
 27.     label var p_std    "折算后单价（同一 unit_std 内可比）"
 28. 
.     * ---- 规整前 vs 规整后 ----
.     _conc unit     "规整前（原始拼写，89,477 个取值）"
 29.     _conc unit_std "规整后（量纲折算 + OTHER）"
 30. 
.     * 再看一版：把 OTHER 排除掉（OTHER 只占约 1% 金额，看看它是不是在虚增单位数）
.     preserve
 31.         qui drop if unit_std == "OTHER"
 32.         _conc unit_std "规整后（且剔除 OTHER）"
 33.     restore
 34. 
.     * ---- 导出完整的 产品 × 规范单位 矩阵（本地可复算，别再来一轮）----
.     preserve
 35.         qui collapse (sum) value qty_std (count) nrec = p, by(product_id unit_std dimension)
 36.         bysort product_id: egen double v_prod = total(value)
 37.         qui gen double share = value / v_prod
 38.         gsort product_id -value
 39.         order product_id unit_std dimension nrec value share qty_std v_prod
 40.         export delimited using "$prof/product_unit_matrix_`side'.csv", replace
 41.         qui count
 42.         di as text "  → product_unit_matrix_`side'.csv  行数 = " as result r(N)
 43.     restore
 44. 
.     * ---- 规范单位清单 ----
.     preserve
 45.         qui collapse (count) nrec = p (sum) value qty_std, by(unit_std dimension)
 46.         gsort -value
 47.         export delimited using "$prof/unit_std_freq_`side'.csv", replace
 48.     restore
 49. 
.     qui compress
 50.     qui save "$dta/firm_`side'_std.dta", replace
 51.     di as text "  → firm_`side'_std.dta"
 52. }


